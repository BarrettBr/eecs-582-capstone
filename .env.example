APP_ENV=development
LOG_LEVEL=debug
SECRET=
SQLITE_PATH=./data/app.db
SQLITE_ENABLE_WAL=true
SQLITE_SYNCHRONOUS=NORMAL
MIGRATIONS_PATH=sql/schema
MODBUS_ADDRESS=127.0.0.1:1502
MODBUS_POLL_INTERVAL=5ms
MODBUS_MW_BASE=1024
SOURCE_CONFIG_PATH=config/sources.json
VALIDATION_FILE_PATH=config/validation/temperature.json
ML_API_URL=
ML_DEBUG=true
ML_PORT=8000
ML_HTTP_TIMEOUT=500ms
ML_BATCH_SIZE=32
ML_BATCH_FLUSH_INTERVAL=25ms
ML_DROP_ON_OVERLOAD=true
WS_ADDRESS=0.0.0.0:8080
WS_PATH=/ws
API_BASE_PATH=/api/v1
WS_BATCH_SIZE=16
WS_BATCH_FLUSH_INTERVAL=50ms
SQL_BATCH_SIZE=256
SQL_BATCH_FLUSH_INTERVAL=25ms
SQL_NORMAL_SAMPLE_RATE=1
INGEST_PORT=8080
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_INGEST_WS_URL=
VITE_APP_NAME=sentinel-dashboard
NODE_ENV=development
