SQLITE_PATH=./data/app.db
SQLITE_ENABLE_WAL=true
SQLITE_SYNCHRONOUS=NORMAL
MIGRATIONS_PATH=sql/schema

SOURCE_CONFIG_PATH=config/sources.json
MODBUS_POLL_INTERVAL=5ms
BUFFER_CHUNK_SIZE=32

ML_API_URL=
ML_HTTP_TIMEOUT=500ms
ML_BATCH_SIZE=32
ML_BATCH_FLUSH_INTERVAL=25ms

WS_ADDRESS=0.0.0.0:8080
WS_PATH=/ws
API_BASE_PATH=/api/v1
WS_BATCH_SIZE=16
WS_BATCH_FLUSH_INTERVAL=50ms

SQL_BATCH_SIZE=256
SQL_BATCH_FLUSH_INTERVAL=25ms
SQL_NORMAL_SAMPLE_RATE=1

VITE_API_BASE_URL=http://localhost:8000/api
VITE_INGEST_WS_URL=
VITE_INGEST_WS_PORT=8080
VITE_INGEST_WS_PATH=/ws
VITE_STREAM_UI_FLUSH_INTERVAL_MS=250
